# ---- Isko copy karke ".env" naam se save karo, phir values bharo ----

PORT=5000

# MongoDB connection string
# Local MongoDB:   mongodb://127.0.0.1:27017/exampro
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/exampro?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/exampro

# Login token ke liye secret — koi lambi random string rakho (kisi ko batana mat)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Pehli baar server start hone par yeh admin account ban jaata hai
ADMIN_EMAIL=admin@exam.com
ADMIN_PASSWORD=admin123

# (Optional) AI Question Generator ke liye — https://console.anthropic.com se key lo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# (Optional) Forgot-password OTP email bhejne ke liye SMTP.
# Khali chhodoge to OTP server console mein print hoga aur (development mein) screen par dikhega.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ExamPro <no-reply@exampro.local>

# ---- Forgot-password OTP: Gmail se email bhejna ----
# 1) Google Account > Security > 2-Step Verification ON karo
# 2) Google Account > Security > App passwords > naya app password banao (16 letters)
# 3) Neeche bharo (normal Gmail password NAHI chalega):
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=aapka@gmail.com
#    SMTP_PASS=abcdefghijklmnop
#    MAIL_FROM=ExamPro <aapka@gmail.com>

# ---- Forgot-password OTP: seedha phone par SMS (optional) ----
# SMS_PROVIDER=fast2sms   (India)  ya  twilio
# FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
SMS_PROVIDER=
FAST2SMS_API_KEY=
